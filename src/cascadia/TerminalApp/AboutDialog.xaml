<ContentDialog x:Class="TerminalApp.AboutDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:local="using:TerminalApp"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:mtu="using:Microsoft.Terminal.UI"
               xmlns:mux="using:Microsoft.UI.Xaml.Controls"
               x:Uid="AboutDialog"
               DefaultButton="Close"
               PrimaryButtonClick="_SendFeedbackOnClick"
               Style="{StaticResource DefaultContentDialogStyle}"
               mc:Ignorable="d">

    <StackPanel Orientation="Vertical">
        <TextBlock IsTextSelectionEnabled="True">
            <TextBlock.ContextFlyout>
                <mtu:TextMenuFlyout />
            </TextBlock.ContextFlyout>
            <Run AutomationProperties.HeadingLevel="1"
                 Text="{x:Bind ApplicationDisplayName}" /> <LineBreak />
            <Run x:Uid="AboutDialog_VersionLabel" />
            <Run Text="{x:Bind ApplicationVersion}" />
        </TextBlock>

        <StackPanel Spacing="10" Margin="0,16,0,12">
            <TextBlock x:Name="MiskuUpdateStatus" TextWrapping="Wrap" />
            <mux:ProgressRing x:Name="MiskuUpdateProgress" Width="18" Height="18"
                              HorizontalAlignment="Left" IsActive="False" Visibility="Collapsed" />
            <Button x:Name="MiskuCheckUpdatesButton" x:Uid="MiskuCheckUpdatesButton" Click="_CheckUpdates" />
            <Button x:Name="MiskuInstallUpdateButton" x:Uid="MiskuUpdateInstallButton" Click="_InstallUpdate" Visibility="Collapsed" />
            <Button x:Name="MiskuReleaseNotesButton" x:Uid="MiskuUpdateNotesButton" Click="_UpdateNotes" Visibility="Collapsed" />
            <ToggleSwitch x:Name="MiskuAutomaticUpdates" x:Uid="MiskuAutomaticUpdates" Toggled="_UpdatePreferences" />
            <ToggleSwitch x:Name="MiskuPreviewUpdates" x:Uid="MiskuPreviewUpdates" Toggled="_UpdatePreferences" />
        </StackPanel>

        <StackPanel Margin="-12,0,0,0"
                    Orientation="Vertical">
            <HyperlinkButton x:Uid="AboutDialog_SourceCodeLink"
                             NavigateUri="https://github.com/JohannRojas/misku-terminal" />
            <HyperlinkButton x:Uid="AboutDialog_DocumentationLink"
                             NavigateUri="https://github.com/JohannRojas/misku-terminal/blob/main/doc/misku-installation.md" />
            <HyperlinkButton x:Uid="AboutDialog_ReleaseNotesLink"
                             NavigateUri="https://github.com/JohannRojas/misku-terminal/releases" />
            <HyperlinkButton x:Uid="AboutDialog_PrivacyPolicyLink"
                             NavigateUri="https://go.microsoft.com/fwlink/?linkid=2125418" />
            <HyperlinkButton x:Uid="AboutDialog_ThirdPartyNoticesLink"
                             Click="_ThirdPartyNoticesOnClick" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
