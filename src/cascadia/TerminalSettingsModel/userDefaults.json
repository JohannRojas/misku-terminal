{
    // "defaultProfile" is filled in by CascadiaSettings, preferring PowerShell 7+
    // when available and falling back to Windows PowerShell otherwise.
    "copyOnSelect": false,
    "copyFormatting": false,
    "theme": "Misku Dark",
    "profiles":
    {
        "defaults":
        {
            "colorScheme": "Misku Dark",
            "cursorShape": "bar",
            "fontFace": "Cascadia Mono",
            "fontSize": 12,
            "historySize": 9001,
            "opacity": 100,
            "padding": "8, 8, 8, 8",
            "startingDirectory": "%USERPROFILE%",
            "useAcrylic": false
        },
        "list":
        [
            {
                "guid": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
                "name": "Windows PowerShell",
                "commandline": "%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
                "hidden": false
            },
            {
                // "name" is filled in by CascadiaSettings as a localized string.
                "guid": "{0caa0dad-35be-5f56-a8ff-afceeeaa6101}",
                "commandline": "%SystemRoot%\\System32\\cmd.exe",
                "hidden": true
            }
        ]
    },
    "keybindings":
    [
        { "id": "Terminal.CopyToClipboard", "keys": "ctrl+c" },
        { "id": "Terminal.PasteFromClipboard", "keys": "ctrl+v" },
        { "id": "Terminal.SplitPaneRight", "keys": "ctrl+shift+d" },
        { "id": "Terminal.SplitPaneDown", "keys": "ctrl+shift+e" },
        { "id": "Terminal.ToggleCommandPalette", "keys": "ctrl+shift+p" },
        { "id": "Terminal.OpenSettingsFile", "keys": "ctrl+shift+," },
        { "id": "Terminal.ToggleFullscreen", "keys": "f11" }
    ]
}
